class Model:
    def __init__(self):
        model_filepath = "/home/pi/Downloads/model.tflite"  # Adjust path if needed
        self.interpreter = tf.lite.Interpreter(model_path=model_filepath)
        self.interpreter.allocate_tensors()
        self.input_details = self.interpreter.get_input_details()
        self.output_details = self.interpreter.get_output_details()
        assert len(self.input_details) == 1 and len(self.output_details) == 1
        self.input_shape = self.input_details[0]['shape'][1:3]  # Extract height and width
 
    def predict(self, image_filepath):
        image = Image.open(image_filepath).resize(self.input_shape)
        input_array = np.array(image, dtype=np.float32)[np.newaxis, :, :, :]
        input_array = input_array[:, :, :, (2, 1, 0)]  # Convert to BGR
        self.interpreter.set_tensor(self.input_details[0]['index'], input_array)
        self.interpreter.invoke()
        return {detail['name']: self.interpreter.get_tensor(detail['index']) for detail in self.output_details}

# Load the labels from labels.txt
with open("/home/pi/Downloads/labels.txt", "r") as f:  # Adjust path if needed
    labels = [line.strip() for line in f.readlines()]

def capture_image(cam):
    try:
        node = hex(uuid.getnode())  # Generate a unique identifier
        cam.set_controls({"AfMode": controls.AfModeEnum.Continuous})
        time.sleep(2)
        start_time = time.time()
        while time.time() - start_time < 10:
            frame = cam.capture_array()
            cv2.imshow("Camera Preview", frame)
            if cv2.waitKey(1) == ord('q'):
                break
        t = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
        image_path = f'/home/pi/Downloads/photo-{node}-{t}.jpg'  # Adjust path if needed
        cam.capture_file(image_path)
        cv2.destroyAllWindows()
        time.sleep(1)
        print(image_path)
        return image_path
    except Exception as e:
        print(f"Error capturing image: {e}")
        return None

def predict_freshness(model, image_path):
    try:
        outputs = model.predict(image_path)
        outputs = list(outputs.values())[0]
        max_index = np.argmax(outputs[0])
        tag = labels[max_index]
        probability = outputs[0][max_index]
        threshold = 0.5
        if probability < threshold:
            return None, probability
        return tag, probability
    except Exception as e:
        print(f"Error predicting freshness: {e}")
        return None, None

def get_waste_color(waste_type):
    waste_type = waste_type.lower()
    if "beveragecartons" in waste_type:
        return [255, 0, 0]    # Red
    elif "cans" in waste_type:
        return [255, 255, 0]  # Yellow
    elif "foodwaste" in waste_type:
        return [0, 0, 255]    # Blue
    elif "glassbottle" in waste_type:
        return [0, 255, 0]    # Green
    elif "plastic" in waste_type:
        return [0, 125, 125]    # Pink

